# Your existing exported OPENROUTER_API_KEY is used automatically.
# If needed, put your key in .env (gitignored); never commit it.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RAGBENCH_MODEL=openai/gpt-4.1-mini
RAGBENCH_EMBEDDING_MODEL=openai/text-embedding-3-small
RAGBENCH_EMBEDDING_DIM=1536
RAGBENCH_NEO4J_URI=bolt://127.0.0.1:17687
RAGBENCH_NEO4J_USER=neo4j
RAGBENCH_NEO4J_PASSWORD=ragbench-local-only
RAGBENCH_DATA_DIR=.ragbench
RAGBENCH_RUNS_DIR=runs
RAGBENCH_CONCURRENCY=4
RAGBENCH_REQUEST_TIMEOUT=120
